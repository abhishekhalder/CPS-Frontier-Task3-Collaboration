function cost = evaluate_path_transport_cost(C,K,u,s,n,epsilon)
    % Form the U tensor
    U = tensorprod(u{1},u{2},2,2); for i=3:num_dist; U = tensorprod(U,u{i}); end
    cost = recursive_eval(C,K,U,s,n,[]);
return

% ! WARNING: this is dumb
function cost = recursive_eval(C,K,U,s,n,epsilon,inds)
    if s==0
        Cel = 0; for i=1:len(inds-1); Cel = Cel + C{i}(inds(i),inds(i+1)); end
        Kel = 1; for i=1:len(inds-1); Kel = Kel * K{i}(inds(i),inds(i+1)); end
        Uel = U(sub2ind(size(U),num2cell(inds)));
        Mel = Kel * Uel;
        cost = ( Cel + epsilon*log(Mel) ) * Mel;
        return
    else 
        for i=1:n
            cost = cost + recursive_eval(C,K,U,s-1,n,epsilon[inds i]);
        end
    end
return